{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://eleen-lifestyle.pages.dev",
          "http://localhost:8788"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
