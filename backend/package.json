{
  "name": "eileen-lifestyle-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "start:railway": "npm run migrate && npm start",
    "check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.0",
    "pdfkit": "^0.20.1",
    "postgres": "^3.4.7",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pdfkit": "^0.17.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}